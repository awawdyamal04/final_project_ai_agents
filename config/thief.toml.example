# Private per-peer configuration -- THIEF.
#
# Copy to config/thief/game.toml and edit. Never committed with real values,
# never sent over the network, never signed, and NOT an input to config_sha256.
#
# The cop and the thief run as two entirely separate processes under separate
# configuration directories (E-1). Sharing memory or variables between them
# breaks the zero-trust model and disqualifies the solution even if the game
# works technically (E-2).

version = "1.10"

[game]
group_name = "PLACEHOLDER-Team"
group_id   = "PLACEH01"          # exactly 8 characters, no spaces (E-45)
members    = ["id-0000", "id-0001"]
repos = { cop = "https://github.com/PLACEHOLDER/cop-repo", thief = "https://github.com/PLACEHOLDER/thief-repo" }

[network]
role         = "thief"
host         = "127.0.0.1"
port         = 8802                          # MY FastMCP server port
opponent_url = "http://127.0.0.1:8801/mcp"   # the only thing I know about the opponent
turn_timeout_seconds = 180

[strategy]
# Leave empty to run the shipped heuristic brain.
# thief_class = "my_team.strategy:MyThiefBrain"

[trash_talk]
provider      = "template"
every_n_steps = 1

[llm]
model                 = ""
step_deadline_seconds = 30

[email]
recipient = "rmisegal+uoh26finalgame@gmail.com"
mode      = "send"

# PATHS ONLY -- gitignored secrets (E-39, E-40), contents never in config.
credentials_path = "credentials.json"
token_path       = "token.json"
